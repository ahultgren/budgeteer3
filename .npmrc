# pnpm's strict, symlinked node_modules doesn't hoist packages that are only reached
# indirectly (e.g. @babel/parser via magicast, @primevue/forms via the PrimeVue Nuxt
# module). Nuxt's build and prepare step import those by bare specifier and fail to
# resolve them. shamefully-hoist mirrors the flat npm layout the app already builds with,
# making installs deterministic. It changes node_modules layout only — the lockfile is
# unaffected, so `pnpm install --frozen-lockfile` still passes in CI.
shamefully-hoist=true
